# Telegram
TELEGRAM_BOT_TOKEN=put_telegram_bot_token_here

# HTTP-сервер бота. Сюда backend будет отправлять кампании/платежи.
HTTP_ADDR=:8090
INTERNAL_SECRET=change_me_long_random_string

# Фиксированные Telegram-беседы.
# Кампании всегда уходят только сюда.
CAMPAIGNS_CHAT_ID=-1001111111111
# Платежи всегда уходят только сюда.
PAYMENTS_CHAT_ID=-1002222222222

# TwinBid backend
BACKEND_BASE_URL=https://twinbid.io
BACKEND_ADMIN_EMAIL=bot-admin@example.com
BACKEND_ADMIN_PASSWORD=change_me

# Локальное хранение токенов и действий по платежам
TOKEN_STORE_PATH=./data/tokens.json
CHAT_STORE_PATH=./data/chats.json
PAYMENT_ACTION_STORE_PATH=./data/payment_actions.json

# Кто может нажимать кнопки.
# Через запятую Telegram user_id. Если пусто — разрешены все, для прода лучше заполнить.
ALLOWED_TELEGRAM_USER_IDS=
